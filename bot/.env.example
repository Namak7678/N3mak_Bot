TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
DATABASE_URL=postgresql://user:pass@host:port/dbname
REDIS_URL=redis://host:port
PORT=3000
PUBLIC_URL=https://your-railway-domain.up.railway.app
NODE_ENV=production

# --- D13/D14: Operations room topics (ADR-009) ---------------------------
OPERATIONS_GROUP_ID=-1000000000000
TOPIC_IDS=war-room=0,eng-dev=0,research=0,marketing=0,quality=0,boardroom=0
HQ_DAILY_REPORT_TEXT=

# --- Existing OmniRoute / OpenAI-compatible provider ---------------------
# Used only when neither N3MAK_FREE_AI nor OVH anonymous mode is enabled.
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=n3mak-local
OPENAI_MODEL=cfp/openai/gpt-oss-20b

# OVHcloud anonymous API is rate-limited but model usage is billable.
# Do not enable it as a free provider. No OVH route is configured here.

# --- SARA: existing Cloudflare Workers AI free demo route ----------------
# Uses the already deployed N3mak gateway; no external API key required.
# The gateway limits this demo endpoint to 1 request/minute and 3/day per IP.
N3MAK_CF_DEMO_ENABLED=false
N3MAK_CF_DEMO_BASE_URL=https://n3mak-gateway.n3mak.workers.dev/v1/demo

# --- Optional internal N3mak Free AI gateway route ----------------------
# This takes priority over OVH when explicitly enabled and token is present.
N3MAK_FREE_AI_ENABLED=false
N3MAK_FREE_AI_BASE_URL=https://n3mak-gateway.n3mak.workers.dev/v1/internal/free
# Set N3MAK_FREE_AI_TOKEN as a Railway secret; never commit its value.

# --- Security hardening --------------------------------------------------
STATS_TOKEN=
BOT_CORS_ORIGINS=
