TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
DATABASE_URL=postgresql://user:pass@host:port/dbname
REDIS_URL=redis://host:port
PORT=3000
PUBLIC_URL=https://your-railway-domain.up.railway.app
NODE_ENV=production

# --- OmniRoute → free CFP (or optional Grok) ---------------------------------
# Point the bot at OmniRoute (see Namak7678/omniroute docs/N3MAK_GROK.md)
# Free default (no xAI billing): cfp/openai/gpt-oss-20b
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=n3mak-local
OPENAI_MODEL=cfp/openai/gpt-oss-20b
# --- Security hardening (2026-10-15) ---
# Required to open /api/stats (closed by default). Generate: openssl rand -hex 24
STATS_TOKEN=
# Comma-separated origins allowed to call the bot API from a browser (e.g. https://n3mak.com)
BOT_CORS_ORIGINS=
