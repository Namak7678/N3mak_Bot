TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
DATABASE_URL=postgresql://user:pass@host:port/dbname
REDIS_URL=redis://host:port
PORT=3000
PUBLIC_URL=https://your-railway-domain.up.railway.app
NODE_ENV=production

# Preferred: xAI Grok (works in production, no OmniRoute needed)
XAI_API_KEY=xai-your-key
OPENAI_MODEL=grok-4-latest

# Optional local OmniRoute only (ignored in production if 127.0.0.1)
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1
# OPENAI_API_KEY=n3mak-local
