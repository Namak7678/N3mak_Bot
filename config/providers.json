{
  "version": "1.0",
  "policy": {
    "default": "disabled",
    "credential_store": "native_sqlcipher_only",
    "activation_gates": [
      "explicit_commander_permission",
      "successful_health_check",
      "read_only_rollback_ready"
    ],
    "note": "Catalog presence does not mean an account is connected. Inference remains blocked until the provider-specific gates pass."
  },
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.openai.com/v1",
      "default_model": "gpt-4.1-mini",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "adapter": "anthropic",
      "auth": "x-api-key",
      "base_url": "https://api.anthropic.com/v1",
      "default_model": "claude-sonnet-4-5",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "google-gemini",
      "name": "Google Gemini",
      "adapter": "gemini",
      "auth": "query-key",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "default_model": "gemini-2.5-flash",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "azure-openai",
      "name": "Azure OpenAI",
      "adapter": "azure_openai",
      "auth": "api-key",
      "base_url": "",
      "default_model": "deployment-name",
      "local": false,
      "status": "unconfigured",
      "custom_endpoint_required": true
    },
    {
      "id": "aws-bedrock",
      "name": "AWS Bedrock",
      "adapter": "aws_bedrock",
      "auth": "aws-sigv4",
      "base_url": "",
      "default_model": "anthropic.claude-3-5-sonnet-20241022-v2:0",
      "local": false,
      "status": "adapter_required",
      "operational": false,
      "custom_endpoint_required": true,
      "note": "Catalog-only until a native AWS SigV4 credential chain and Bedrock request adapter are implemented and tested."
    },
    {
      "id": "mistral",
      "name": "Mistral AI",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.mistral.ai/v1",
      "default_model": "mistral-small-latest",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "cohere",
      "name": "Cohere",
      "adapter": "cohere",
      "auth": "bearer",
      "base_url": "https://api.cohere.com/v2",
      "default_model": "command-a-plus-05-2026",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "groq",
      "name": "Groq",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.groq.com/openai/v1",
      "default_model": "llama-3.3-70b-versatile",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "together",
      "name": "Together AI",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.together.xyz/v1",
      "default_model": "meta-llama/Llama-3.3-70B-Instruct-Turbo",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://openrouter.ai/api/v1",
      "default_model": "openai/gpt-4.1-mini",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "xai",
      "name": "xAI",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.x.ai/v1",
      "default_model": "grok-3-mini",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.deepseek.com/v1",
      "default_model": "deepseek-chat",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "perplexity",
      "name": "Perplexity",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.perplexity.ai",
      "default_model": "sonar",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "fireworks",
      "name": "Fireworks AI",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.fireworks.ai/inference/v1",
      "default_model": "accounts/fireworks/models/llama-v3p3-70b-instruct",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "cerebras",
      "name": "Cerebras",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.cerebras.ai/v1",
      "default_model": "llama-3.3-70b",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "sambanova",
      "name": "SambaNova Cloud",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://api.sambanova.ai/v1",
      "default_model": "Meta-Llama-3.3-70B-Instruct",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "nvidia-nim",
      "name": "NVIDIA NIM",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "default_model": "meta/llama-3.3-70b-instruct",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "huggingface",
      "name": "Hugging Face Inference",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://router.huggingface.co/v1",
      "default_model": "meta-llama/Llama-3.3-70B-Instruct",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "github-models",
      "name": "GitHub Models",
      "adapter": "openai_compatible",
      "auth": "bearer",
      "base_url": "https://models.inference.ai.azure.com",
      "default_model": "gpt-4o-mini",
      "local": false,
      "status": "unconfigured"
    },
    {
      "id": "ollama",
      "name": "Ollama",
      "adapter": "ollama",
      "auth": "none",
      "base_url": "http://127.0.0.1:11434",
      "default_model": "llama3.2",
      "local": true,
      "status": "unconfigured"
    },
    {
      "id": "lm-studio",
      "name": "LM Studio",
      "adapter": "openai_compatible",
      "auth": "optional-bearer",
      "base_url": "http://127.0.0.1:1234/v1",
      "default_model": "local-model",
      "local": true,
      "status": "unconfigured"
    },
    {
      "id": "vllm",
      "name": "vLLM Server",
      "adapter": "openai_compatible",
      "auth": "optional-bearer",
      "base_url": "http://127.0.0.1:8000/v1",
      "default_model": "served-model",
      "local": true,
      "status": "unconfigured"
    }
  ]
}
